{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athanasiusofalex.github.io/json-document-schemata/schemas/aquinas-opera-omnia/v1/schema.json",
  "title": "Thomistic Aquinas Opera Omnia",
  "description": "A definitive schema for the digital representation of the works of Thomas Aquinas in Latin.",
  "type": "object",
  "required": ["work_metadata", "body"],
  "properties": {
    "work_metadata": {
      "type": "object",
      "required": ["id", "title_latin", "siglum", "critical_edition"],
      "properties": {
        "id": { "type": "string", "description": "Unique identifier, e.g., 'ST'" },
        "title_latin": { "type": "string", "description": "e.g., 'Summa Theologiae'" },
        "title_english": { "type": "string" },
        "siglum": { "type": "string", "description": "Standard abbreviation, e.g., 'S.Th.'" },
        "date_composition": { "type": "string", "description": "Estimated dates, e.g., '1265-1273'" },
        "critical_edition": {
          "type": "object",
          "required": ["name", "publisher", "year"],
          "properties": {
            "name": { "type": "string" },
            "publisher": { "type": "string" },
            "year": { "type": "string" },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "body": {
      "type": "array",
      "items": { "$ref": "#/$defs/structural_node" }
    }
  },
  "$defs": {
    "structural_node": {
      "type": "object",
      "required": ["node_id", "node_type"],
      "properties": {
        "node_id": {
          "type": "string",
          "description": "Hierarchical ID, e.g., 'ST-I-Q2-A3' or 'ST-I-Q2-A3-respondeo'"
        },
        "node_type": {
          "type": "string",
          "enum": [
            "pars", "liber", "distinctio", "quaestio",
            "articulus", "capitulum", "tractatus", "lectio",
            "prooemium",
            "argumentum", "sed_contra", "respondeo",
            "ad_argumentum", "textus_expositus", "expositio", "conclusio"
          ]
        },
        "number": {
          "type": ["string", "integer"],
          "description": "Structural number (e.g., 'I', 'II-II', '3') or argument/reply ordinal (e.g., 1, 2)"
        },
        "title_latin": { "type": "string" },
        "children": {
          "type": "array",
          "description": "Nested structural divisions or scholastic function nodes",
          "items": { "$ref": "#/$defs/structural_node" }
        },
        "paragraphs": {
          "type": "array",
          "description": "Content paragraphs for leaf-level nodes",
          "items": { "$ref": "#/$defs/paragraph" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "node_type": {
                "enum": [
                  "argumentum", "sed_contra", "respondeo",
                  "ad_argumentum", "textus_expositus", "expositio", "conclusio"
                ]
              }
            }
          },
          "then": {
            "required": ["paragraphs"],
            "not": { "required": ["children"] }
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "enum": [
                  "pars", "liber", "distinctio", "quaestio",
                  "articulus", "capitulum", "tractatus", "lectio"
                ]
              }
            }
          },
          "then": {
            "not": { "required": ["paragraphs"] }
          }
        }
      ]
    },
    "paragraph": {
      "type": "object",
      "required": ["paragraph_id", "segments"],
      "properties": {
        "paragraph_id": {
          "type": "string",
          "description": "e.g., 'ST-I-Q2-A3-respondeo-p1'"
        },
        "editorial_id": {
          "type": "string",
          "description": "Editorial paragraph number, e.g., 'Marietti n. 1243'"
        },
        "segments": {
          "type": "array",
          "description": "Text broken into typographical chunks at page/column breaks.",
          "items": { "$ref": "#/$defs/text_segment" }
        }
      }
    },
    "text_segment": {
      "type": "object",
      "required": ["latin_text", "edition_location"],
      "properties": {
        "latin_text": { "type": "string" },
        "edition_location": {
          "type": "object",
          "required": ["volume", "page"],
          "properties": {
            "volume": { "type": "string" },
            "page": { "type": "string" },
            "column": {
              "type": "string",
              "enum": ["a", "b"],
              "description": "Omit for single-column editions."
            },
            "line_start": { "type": ["integer", "null"] },
            "line_end": { "type": ["integer", "null"] }
          }
        }
      }
    }
  }
}