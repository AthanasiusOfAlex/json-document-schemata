                      "paragraph_id": "ST-I-Q2-A3-respondeo-p1",
                      "segments": [
                        {
                          "latin_text": "Respondeo dicendum quod Deum esse quinque viis probari potest. Prima autem et manifestior via est ",
                          "edition_location": {
